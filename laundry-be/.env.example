# Database
DATABASE_URL=postgresql://user:password@host:5432/laundry
DIRECT_URL=postgresql://user:password@host:6543/laundry

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3000
CORS_ORIGIN=http://localhost:3000,https://your-vercel-app.vercel.app

# PayOS (optional - for online payment)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://your-vercel-app.vercel.app/orders
PAYOS_CANCEL_URL=https://your-vercel-app.vercel.app/orders
# URL công khai của backend để PayOS gọi webhook (bắt buộc để tự cập nhật trạng thái đơn)
# Ví dụ: https://laundry-be-production.up.railway.app/payments/payos-webhook
PAYOS_WEBHOOK_URL=
