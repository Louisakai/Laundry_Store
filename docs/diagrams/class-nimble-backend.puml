' =================== SERVICES (business layer) ===================

class AuthService {
  -prisma : PrismaService
  -jwtService : JwtService
  --
  +register(dto)
  +login(dto)
  +refreshToken(rt)
  +getProfile(userId)
  +changePassword(userId, dto)
  -generateTokens()
  -sanitizeUser()
}
class OrderService {
  -prisma : PrismaService
  -eventEmitter : EventEmitter2
  -paymentService : PaymentService
  -STORE_LAT : number @@ constant
  -STORE_LNG : number @@ constant
  -VALID_TRANSITIONS : Record<OrderStatus, OrderStatus[]>
  -ORDER_TYPE_FLOWS : Record<OrderType, OrderStatus[]>
  --
  +findAll/findOne()
  +create(userId, dto)
  +cancel(id, userId, reason)
  +updateStatus(id, userId, dto)
  +weighOrder(id, userId, dto)
  +autoAssignShipper(orderId, userId)
  +assignStaff(id, staffId, userId)
  +completeDelivery(id, userId, amount, provider)
  +confirmPayment(id, userId)
  -haversine()
}
class PaymentService {
  -prisma : PrismaService
  -eventEmitter : EventEmitter2
  --
  +processPayment(orderId, userId, status, amount?, provider?)
  +verifyAndProcessWebhook(webhookData)
}
class ReviewService {
  -prisma : PrismaService
  --
  +create(orderId, userId, dto)
  +findByOrder(orderId, userId, role)
  +findByStaff(staffId)
}
class StaffService {
  -prisma : PrismaService
  -eventEmitter : EventEmitter2
  --
  +create/findAll/findOne/update/remove()
  +getMyOrders(staffId)
  +updateLocation(staffId, lat, lng)
  +setLocationToStore(staffId)
  +toggleAvailability(staffId)
}
class AdminService {
  -prisma : PrismaService
  --
  +getOrders(params)
  +getStats()
  +getRevenue(from, to)
  +getAnalyticsOrders()
  +getStaffAnalytics()
  +getDailyRevenue()
  +getServiceAnalytics()
  +getServiceReviews()
  +updateOrderServices()
  +updateOrderPrice()
}
class NotificationService {
  -prisma : PrismaService
  --
  +findAll(userId)
  +markAsRead(id, userId)
  +markAllAsRead(userId)
}
class AddressService {
  -prisma : PrismaService
  --
  +findAllByUser(userId)
  +findOne(id, userId)
  +create(userId, dto)
  +update(id, userId, dto)
  +remove(id, userId)
  +setDefault(id, userId)
}
class ServiceService {
  -prisma : PrismaService
  --
  +findAll()
  +findOne(id)
  +create(dto)
  +update(id, dto)
  +remove(id) (soft-delete isActive=false)
}
class OsmService <<OnModuleInit>> {
  -logger : Logger
  -graph : GraphData | null
  -graphReady : boolean
  -osmFilePath : string
  --
  +onModuleInit()
  +shortestPath()
  +loadGraph()
}
class RouteService {
  -prisma : PrismaService
  -osmService : OsmService (forwardRef)
  --
  +optimize()
  +nearestShipper()
  +navigate()
}

' =================== INFRA / CROSS-CUTTING ===================

class PrismaService <<PrismaClient>> {
  +$transaction(fn)
  +order / user / service / ...
}

class OrderTrackingGateway <<WebSocket>> {
  -server : Server
  -jwtService : JwtService
  --
  +namespace /orders
  -handleConnection(client)
  +@SubscribeMessage join-order/leave-order
  +@OnEvent order.status-changed → room order-{id}
  +@OnEvent order.assigned → room staff-{staffId}
  +@OnEvent staff.location-updated
}

class JwtAuthGuard <<Guard AuthGuard('jwt')>> {
  extends AuthGuard('jwt')
  -- xác minh Bearer token (JwtStrategy)
  trang bị user = { userId, email, role } vào req
  lỗi/sai → 401 Unauthorized
}
class RolesGuard <<Guard CanActivate>> {
  -reflector : Reflector
  +canActivate(context): boolean
  -- đọc @Roles(...) từ handler
  user.role ∈ yêu cầu → cho qua (không khai @Roles → ai cũng qua)
}
class JwtStrategy <<Strategy>> {
  -prisma : PrismaService
  --
  +validate(payload)
}
class RolesDecorator <<Decorator>> {
  +@Roles('CUSTOMER'|'STAFF'|'ADMIN')
}

' =================== DTOs ===================

class CreateOrderDto {
  orderType: OrderType
  pickupAddressId?
  deliveryAddressId?
  pickupWindowStart?/End?
  deliveryWindowStart?/End?
  notes?, contact fields?
  items: CreateOrderItemDto[]
}
class CreateOrderItemDto {
  serviceId
}
class UpdateOrderStatusDto {
  status: OrderStatus
  note?
  lat? / lng?
}
class WeighOrderDto {
  items: WeighItemDto[]
}
class CreateReviewDto {
  serviceRating (1-5)
  serviceComment?
  shipperRating?
  shipperComment?
}
class LoginDto {
  @IsEmail() email: string
  @IsNotEmpty() password: string
}
class RegisterDto {
  @IsEmail() email: string
  @MinLength(6) password: string
  fullName: string
  @Matches(/^0\d{9,10}$/) phone: string
  @IsEnum(Role) role?: Role
}
class RefreshDto {
  @IsNotEmpty() refreshToken: string
}
class CreateAddressDto {
  @IsString() label: string
  @IsString() addressLine: string
  @IsNumber() latitude: number
  @IsNumber() longitude: number
  @IsBoolean() @IsOptional() isDefault?
}
class UpdateAddressDto {
  fields tương tự CreateAddressDto (toàn bộ optional)
}
class CreateServiceDto {
  @IsString() name: string
  @IsString() @IsOptional() description?
  @IsNumber() @Min(0) pricePerUnit: number
  @IsString() unit: string
  @IsBoolean() @IsOptional() isActive?
}
class UpdateServiceDto {
  fields tương tự CreateServiceDto (toàn bộ optional)
}

class EventEmitter2 <<Event>> {
  +emit(event, payload)
  +on(event, listener)
}

class JwtService <<@nestjs/jwt>> {
  +sign(payload, opts): string
  +verify(token): JwtPayload
}

' =================== ENTITY MODELS (Prisma schema) ===================

class User <<users>> {
  -id : string <<PK>>
  -email : string <<unique>>
  -passwordHash : string
  -fullName : string
  -phone : string
  -role : Role <<CUSTOMER/STAFF/ADMIN>>
  -staffType : StaffType?
  -preferences : Json?
  -workZone : string?
  -isAvailable : boolean?
  -currentLat : float?
  -currentLng : float?
  -locationUpdatedAt : DateTime?
  -createdAt : DateTime
  -updatedAt : DateTime
}
class Address <<addresses>> {
  -id : string <<PK>>
  -userId : string <<FK→User>>
  -label : string
  -addressLine : string
  -latitude : float
  -longitude : float
  -isDefault : boolean
  -createdAt : DateTime
}
class Service <<services>> {
  -id : string <<PK>>
  -name : string
  -description : string?
  -pricePerUnit : float
  -unit : string <<"kg","cái","đôi">>
  -isActive : boolean
  -createdAt : DateTime
  -updatedAt : DateTime
}
class Order <<orders>> {
  -id : string <<PK>>
  -customerId : string <<FK→User>>
  -staffId : string? <<FK→User>>
  -pickupAddressId : string?
  -deliveryAddressId : string?
  -status : OrderStatus <<PENDING...DELIVERED>>
  -totalPrice : float
  -orderType : OrderType <<ONLINE/WALKIN/DROP_OFF>>
  -notes : string?
  -pickupWindowStart/End : DateTime?
  -deliveryWindowStart/End : DateTime?
  -pickupContactName/Phone : string?
  -deliveryContactName/Phone : string?
  -cancellationReason : string?
  -paymentMethod : PaymentProvider <<CASH/PAYOS>>
  -paymentStatus : PaymentStatus <<PENDING/SUCCESS/FAILED/REFUNDED>>
  -createdAt : DateTime
  -updatedAt : DateTime
}
class OrderItem <<order_items>> {
  -id : string <<PK>>
  -orderId : string <<FK→Order>>
  -serviceId : string <<FK→Service>>
  -quantity : float?
  -price : float <<snapshot giá Service>>
  -subtotal : float?
  -createdAt : DateTime
}
class OrderTrackingLog <<order_tracking_logs>> {
  -id : string <<PK>>
  -orderId : string <<FK→Order>>
  -changedBy : string <<FK→User>>
  -status : OrderStatus
  -note : string?
  -createdAt : DateTime
}
class Review <<reviews>> {
  -id : string <<PK>>
  -orderId : string <<FK→Order, unique 1-1>>
  -customerId : string <<FK→User>>
  -staffId : string?
  -serviceRating : int <<1-5>>
  -serviceComment : string?
  -shipperRating : int?
  -shipperComment : string?
  -createdAt : DateTime
  -updatedAt : DateTime
}
class Notification <<notifications>> {
  -id : string <<PK>>
  -userId : string <<FK→User>>
  -title : string
  -content : string
  -isRead : boolean
  -type : NotificationType <<ORDER_STATUS/PAYMENT/PROMOTION/SYSTEM>>
  -relatedId : string?
  -createdAt : DateTime
}
class Payment <<payments>> {
  -id : string <<PK>>
  -orderId : string <<FK→Order>>
  -provider : PaymentProvider
  -amount : float
  -status : PaymentStatus
  -providerRef : string? <<unique>>
  -providerPayload : Json?
  -paidAt : DateTime?
  -createdAt : DateTime
  -updatedAt : DateTime
}

