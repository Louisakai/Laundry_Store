@startuml seq-payment
'#################################################
' NIMBLE — Sequence 3: Thanh toán (PAYOS / CASH)
' DỰA THEO code thực tế: src/payment/payment.service.ts
' + src/pay/pay.controller.ts (QR test)
' + src/websocket/order-tracking.gateway.ts
'#################################################

skinparam lifelineStrategy solid
skinparam ParticipantPadding 20
skinparam BoxPadding 10
title Luồng 3: Thanh toán — PAYOS & tiền mặt (chỉ khi đơn COMPLETED/DELIVERING)

actor "Admin / Staff" as Staff
actor "Khách hàng" as Customer
participant "API Backend\n(NestJS)" as Backend
participant "Cổng PAYOS" as PayOS
database "PostgreSQL\n(Supabase)" as DB

activate Backend

note over Staff, DB
  Điều kiện vào: đơn đang ở COMPLETED hoặc DELIVERING
  (order.service.completeDelivery gọi paymentService.processPayment)
end note

== 3a. Khởi tạo thanh toán ==

Staff -> Backend: POST /orders/:id/complete-delivery { amountReceived?, provider? }
Backend -> Backend: processPayment(orderId, userId, currentStatus, ...)
Backend -> DB: INSERT payments (provider, amount=totalPrice, status=PENDING)

alt provider = CASH  (COD)
  Backend -> DB: UPDATE orders SET status=DELIVERED, paymentStatus=SUCCESS
  Backend -> DB: UPDATE payments SET status=SUCCESS, paidAt=now
  Backend -> DB: tracking log (COD: nhận X, tiền thừa Y) + Notification "Đã giao + thanh toán COD"
  Backend --> Staff: 200 { status: DELIVERED, checkoutUrl: null }
else provider = PAYOS
  alt Có cấu hình PAYOS (key thật)
    Backend -> PayOS: paymentLinks.create(orderCode, amount, returnUrl, cancelUrl)
    PayOS --> Backend: checkoutUrl
    Backend -> DB: UPDATE payments SET providerRef=orderCode, providerPayload
    Backend --> Staff: 200 { status: COMPLETED/DELIVERING, checkoutUrl }
    Staff -> Customer: Chuyển cho khách thanh toán
  else Chế độ test (chưa cấu hình PAYOS)
    note right
      checkoutUrl = {appUrl}/pay/{orderId} — trang QR xác nhận test
      providerRef = TEST-<timestamp>
    end note
    Backend --> Staff: 200 { status, checkoutUrl }
  end

  == 3b. Khách thanh toán ==

  alt Khách chọn cổng trên link PayOS / trang test
    Customer -> PayOS: Thanh toán online
    PayOS -> Backend: POST /payments/payos-webhook (webhookData)
    note right
      GET /payments/payos-webhook cũng tồn tại
      (trả { success: true } — để PayOS verify)
    end note
    Backend -> PayOS: verifyPaymentWebhookData (chữ ký)
    alt status = PAID
      Backend -> DB: UPDATE payments SET status=SUCCESS, paidAt + payload
      Backend -> DB: UPDATE orders SET status=DELIVERED, paymentStatus=SUCCESS
      Backend -> DB: Notification "Thanh toán thành công qua PayOS"
      Backend -> Backend: emit WebSocket 'order.status-changed' (DELIVERED)
      PayOS <-- Backend: 200 { success: true }
    else status = CANCELLED
      Backend -> DB: UPDATE payments SET status=FAILED
      PayOS <-- Backend: 200 { success: false }
    end
  else Quét QR trang test (GET /pay/:id → POST /pay/:id/confirm)
    note right
      Trang /pay/:id hiện thông tin đơn + nút
      "Xác nhận đã thanh toán"
    end note
    Customer -> Backend: POST /pay/:id/confirm
    Backend -> DB: UPDATE payments SET status=SUCCESS, paidAt + order.paymentStatus=SUCCESS
    Backend -> DB: Notification "Thanh toán thành công"
    Backend --> Customer: { success: true }
  end
end

note over Staff, DB
  Lưu ý: CHƯA có endpoint hoàn tiền (REFUNDED) trong code.
  Enum PaymentStatus có REFUNDED nhưng chưa triển khai.
end note

deactivate Backend

@enduml