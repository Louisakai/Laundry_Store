@startuml seq-status-updates
'#################################################
' NIMBLE — Sequence 2: Cân + cập nhật trạng thái
' DỰA THEO code thực tế: src/order/order.service.ts
' (VALID_TRANSITIONS, ORDER_TYPE_FLOWS, updateStatus, weighOrder)
' + src/websocket/order-tracking.gateway.ts
'#################################################

skinparam lifelineStrategy solid
skinparam ParticipantPadding 20
skinparam BoxPadding 10
title Luồng 2: Cân đơn → giặt → hoàn tất giao (trạng thái)

participant "Shipper / Washer\n(STAFF)" as Worker
participant "API Backend\n(NestJS)" as Backend
database "PostgreSQL\n(Supabase)" as DB
actor "Admin / Staff" as Staff
actor "Khách hàng" as Customer

activate Backend

== 2a. Cân đơn & tính tiền ==

Worker -> Backend: PATCH /orders/:id/weigh { items[] {orderItemId, quantity} }

note over Worker, Customer
  Mỗi lần đổi trạng thái hợp lệ: Backend tạo
  Notification (type=ORDER_STATUS) cho khách trong DB,
  đồng thời emit WebSocket 'order.status-changed'
  (gateway → room order-{id}).
  Bị giới hạn thêm bởi ORDER_TYPE_FLOWS:
  - ONLINE: đủ PENDING→CONFIRMED→PICKING_UP→RECEIVED→PROCESSING→COMPLETED→DELIVERING→DELIVERED
  - WALKIN: PENDING→RECEIVED→PROCESSING→COMPLETED→DELIVERED (không có PICKING_UP/DELIVERING)
  - DROP_OFF: PENDING→CONFIRMED→RECEIVED→PROCESSING→COMPLETED→DELIVERING→DELIVERED (không PICKING_UP)
end note

Backend -> Backend: chỉ cho phép ở PENDING / CONFIRMED / RECEIVED
Backend -> DB: UPDATE order_items SET quantity, subtotal = qty * price
Backend -> Backend: totalPrice = Σ subtotal; nếu chưa RECEIVED → sang RECEIVED
Backend -> DB: UPDATE orders SET totalPrice, status=RECEIVED(if cần)
Backend -> DB: tracking log + Notification khách "Đơn hàng đã được cân: <total>đ"
DB --> Backend: ok
Backend --> Worker: 200 { totalPrice, status }

== 2b. Washer xử lý (RECEIVED → PROCESSING → COMPLETED) ==

Worker -> Backend: PATCH /orders/:id/status { status: PROCESSING }
Backend -> Backend: bắt buộc đã cân đủ (mọi orderItem.quantity != null)
Backend -> DB: UPDATE orders SET status=PROCESSING + tracking + notification
Backend --> Worker: 200 { status: PROCESSING }

Worker -> Backend: PATCH /orders/:id/status { status: COMPLETED }
Backend -> Backend: hợp lệ: RECEIVED/PROCESSING → COMPLETED; nếu chưa có shipper → auto-assign
Backend -> DB: UPDATE orders SET status=COMPLETED + tracking + notification
Backend -> Backend: emit WebSocket 'order.status-changed'
Backend --> Worker: 200 { status: COMPLETED }

== 2c. Shipper giao (COMPLETED → DELIVERING → DELIVERED) ==

Worker -> Backend: PATCH /orders/:id/status { status: DELIVERING }
Backend -> DB: UPDATE orders SET status=DELIVERING + tracking + notification
Backend -> Backend: emit WebSocket 'order.status-changed'
Backend --> Worker: 200 { status: DELIVERING }

alt Tiền mặt (CASH) — thường đi qua complete-delivery
  Worker -> Backend: POST /orders/:id/complete-delivery { amountReceived, provider: CASH }
  Backend -> Backend: processPayment: tạo Payment PENDING → SUCCESS ngay, amount=totalPrice
  Backend -> DB: UPDATE orders SET status=DELIVERED, paymentStatus=SUCCESS + tracking (COD)
  Backend -> Backend: emit WebSocket 'order.status-changed' (status=DELIVERED)
  Backend --> Worker: 200 { status: DELIVERED }
else Vẫn để DELIVERED riêng bằng status
  Worker -> Backend: PATCH /orders/:id/status { status: DELIVERED }
  Backend -> Backend: hợp lệ: COMPLETED/DELIVERING → DELIVERED (kèm cập nhật vị trí shipper)
  Backend -> DB: UPDATE orders SET status=DELIVERED + tracking + notification
  Backend --> Worker: 200 { status: DELIVERED }
end

deactivate Backend

@enduml